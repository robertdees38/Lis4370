# Assignment 4: Visualizing and Interpreting Hospital Patient Data

# Create vectors
Frequency <- c(0.6, 0.3, 0.4, 0.4, 0.2, 0.6, 0.3, 0.4, 0.9, 0.2)
BloodPressure <- c(103, 87, 32, 42, 59, 109, 78, 205, 135, 176)
FirstAssess <- c(1, 1, 1, 1, 0, 0, 0, 0, NA, 1)
SecondAssess <- c(0, 0, 1, 1, 0, 0, 1, 1, 1, 1)
FinalDecision <- c(0, 1, 0, 1, 0, 1, 0, 1, 1, 1)

# Combine vectors into a data frame
df_hosp <- data.frame(
  Frequency,
  BloodPressure,
  FirstAssess,
  SecondAssess,
  FinalDecision,
  stringsAsFactors = FALSE
)

# Inspect the data
summary(df_hosp)

# Remove the row containing NA
df_hosp <- na.omit(df_hosp)

# Confirm that missing values were removed
summary(df_hosp)

# Save boxplot for first assessment
png("BP_First_Assessment.png")

boxplot(
  BloodPressure ~ FirstAssess,
  data = df_hosp,
  names = c("Good", "Bad"),
  ylab = "Blood Pressure",
  main = "BP by First MD Assessment",
  col = c("lightgreen", "lightcoral")
)

dev.off()

# Save boxplot for second assessment
png("BP_Second_Assessment.png")

boxplot(
  BloodPressure ~ SecondAssess,
  data = df_hosp,
  names = c("Low", "High"),
  ylab = "Blood Pressure",
  main = "BP by Second MD Assessment",
  col = c("lightblue", "orange")
)

dev.off()

# Save boxplot for final decision
png("BP_Final_Decision.png")

boxplot(
  BloodPressure ~ FinalDecision,
  data = df_hosp,
  names = c("Low", "High"),
  ylab = "Blood Pressure",
  main = "BP by Final Decision",
  col = c("lightblue", "orange")
)

dev.off()

# Save frequency histogram
png("Histogram_Frequency.png")

hist(
  df_hosp$Frequency,
  breaks = seq(0, 1, by = 0.1),
  xlab = "Visit Frequency",
  main = "Histogram of Visit Frequency",
  col = "lightblue",
  border = "black"
)

dev.off()

# Save blood pressure histogram
png("Histogram_Blood_Pressure.png")

hist(
  df_hosp$BloodPressure,
  breaks = 8,
  xlab = "Blood Pressure",
  main = "Histogram of Blood Pressure",
  col = "lightgreen",
  border = "black"
)

dev.off()
